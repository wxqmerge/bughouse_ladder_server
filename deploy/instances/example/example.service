[Unit]
Description=Bughouse Chess Ladder - Development
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/html/my-project
Environment=NODE_ENV=production
Environment=PORT=3000
EnvironmentFile=/var/www/bughouse-ladder/server/.env
# Optional protected key file (created by deploy/secure-env.sh); systemd ignores it when absent.
# Use the real instance directory name, e.g. /etc/bughouse-ladder/<instance>.env
EnvironmentFile=-/etc/bughouse-ladder/example.env
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
