# ============================================
# BUGHOUSE CHESS LADDER SERVER - ENVIRONMENT CONFIGURATION
# ============================================
#
# IMPORTANT: Copy this file to .env and fill in the values below.
# NEVER commit the .env file to version control!
#
# ============================================

# ============================================
# SERVER CONFIGURATION
# ============================================

# Server port (uses TCP/HTTP - NOT UDP)
PORT=3000

# Node environment (development or production)
# NOTE for DEPLOYED instances: do NOT set NODE_ENV in server/.env on servers.
# systemd EnvironmentFile= entries OVERRIDE the Environment= lines in the
# service unit, so a stale "development" here silently disables the
# production fail-fast guards. The unit file owns NODE_ENV in production;
# deploy/update.sh and verify.sh now enforce this.
NODE_ENV=development

# ============================================
# SECURITY - OPTIONAL PROTECTION
# =============================================

# CORS Origins - Your frontend domain(s), comma-separated
# Examples:
#   Development: http://localhost:5173
#   Production: https://your-domain.com
CORS_ORIGINS=http://localhost:5173

# Admin API Key - Protects admin endpoints (/api/admin/*)
# Requests must include header: X-API-Key: <this-value>
# Delete or empty this line to disable admin protection (local mode)
# Generate secure key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Production: run `sudo bash ./deploy/secure-env.sh <admin-user>` to move keys
# to /etc/bughouse-ladder/<instance>.env and remove them from server/.env.
ADMIN_API_KEY=dev-admin-key-change-in-production

# User API Key - Protects write operations (PUT/DELETE on ladder, POST on games)
# Users without a valid key can only VIEW the table (read-only)
# Users with a valid key can edit, enter games, and save
# Delete or empty this line to disable user auth (local/dev mode)
USER_API_KEY=change-this-to-a-random-key

# Hide PII (phone, school, room, info) from read endpoints when no valid
# API key is sent. ON BY DEFAULT; set to false only if you accept exposing
# contact fields to anonymous readers.
# ANON_HIDE_PII=false

# ── Optional hardening knobs (defaults shown) ──────────────────────
# Reverse-proxy hops to trust for X-Forwarded-For. Set to 0 when the node
# port is exposed directly (prevents IP-spoofed rate-limit bypass).
# TRUST_PROXY=1
# Global cap on simultaneous unauthenticated SSE connections.
# MAX_SSE_CLIENTS=200
# SSE reconnect budget per IP (per 15 min).
# SSE_MAX_CONNECTS_PER_IP=120

# ============================================
# DATA CONFIGURATION
# ============================================

# Path to ladder data file
TAB_FILE_PATH=./data/ladder.tab
